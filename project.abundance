            }
          ]
        },
        {
          "atomType": "Code",
          "x": 0.6,
          "y": 0.4,
          "uniqueID": "id-8178",
          "ioValues": [
            {
              "name": "thickness",
              "ioValue": 22
            },
            {
              "name": "shape",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "radius",
              "ioValue": 3
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Rounds the outline edges on both flat faces of an extruded profile\n * (the z = 0 and z = thickness faces), giving the part soft, organic edges.\n */\nfunction run(shape: Assembly, radius: number = 3, thickness: number = 22): Assembly {\n  return shape.onLeafs((leaf) => {\n    if (!replicad.isShape3D(leaf.geometry)) return leaf;\n    leaf.geometry = leaf.geometry.fillet(radius, (e) =>\n      e.either([(f) => f.inPlane(\"XY\", 0), (f) => f.inPlane(\"XY\", thickness)])\n    );\n    return leaf;\n  });\n}",
          "compiledCode": "\"use strict\";\n/**\n * Rounds the outline edges on both flat faces of an extruded profile\n * (the z = 0 and z = thickness faces), giving the part soft, organic edges.\n */\nfunction run(shape, radius = 3, thickness = 22) {\n    return shape.onLeafs((leaf) => {\n        if (!replicad.isShape3D(leaf.geometry))\n            return leaf;\n        leaf.geometry = leaf.geometry.fillet(radius, (e) => e.either([(f) => f.inPlane(\"XY\", 0), (f) => f.inPlane(\"XY\", thickness)]));\n        return leaf;\n    });\n}\n"
        }
      ],
